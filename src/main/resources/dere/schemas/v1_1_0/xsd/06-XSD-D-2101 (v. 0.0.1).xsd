<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.dere.gov.br/schemas/evtDebOpOfPublic/v0_0_1"
           targetNamespace="http://www.dere.gov.br/schemas/evtDebOpOfPublic/v0_0_1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema.xsd"/>
  <xs:element name="DeRE">
    <xs:annotation>
      <xs:documentation>Envelope raiz dos eventos da DeRE.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
      <xs:element name="evtDebOpOfPublic">
        <xs:annotation>
          <xs:documentation>Evento débito mensal de operações com títulos de dívida com oferta pública.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
          <xs:element name="ideEvento" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de identificação do evento.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="tpOper" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Tipo de operação do evento. Nota: A alteração substitui integralmente as informações do evento enviado anteriormente.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Inclusão</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Alteração</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="3">
                      <xs:annotation><xs:documentation>Exclusão</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="motExcl" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Motivo da Exclusão. Código do motivo que justifica a exclusão do evento. Validação: Obrigatório se {tpOper} = [3].</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Determinação judicial ou administrativa</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Envio indevido (fato inexistente)</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="3">
                      <xs:annotation><xs:documentation>Erro na identificação (CNPJ/período incorretos)</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="9">
                      <xs:annotation><xs:documentation>Outro</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="nrProc" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Informar o número do processo administrativo/judicial. Validação: Obrigatório se {motExcl} = [1]. Deve ser um número de processo válido e existente no evento D-1021.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:maxLength value="21"/>
                    <xs:pattern value="[A-Za-z0-9]+"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="nrRecibo" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Caso seja um evento de alteração/retificação ou exclusão, preencher com o número do recibo do arquivo a ser alterado/retificado ou excluído.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="31"/>
                    <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="tpAmb" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Identificação do ambiente para o qual os dados estão sendo transmitidos.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Produção</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Produção restrita</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="aplicEmi" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Identificação do aplicativo emissor do evento.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Emissão com aplicativo da empresa</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Aplicativo governamental</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="verAplic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Versão do aplicativo emissor do evento.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:maxLength value="20"/>
                    <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ideContrib" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de identificação do contribuinte.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="nrInsc" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número de inscrição do contribuinte (CNPJ raiz). Validação: Deve ser um CNPJ raiz válido de 8 posições.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="8"/>
                    <xs:pattern value="[0-9A-Z]{8}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="idePeriodo" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Período de referência das informações do evento.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="perApur" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Informar o período de apuração, sendo o ano e mês da competência da declaração. Máscara: AAAA-MM Validação: Se {tpOper} = [1], só pode existir um único {perApur} para cada {nrInsc}. Quando informado {nrRecibo}, o {perApur} deve ser exatamento ao mesmo existente no {nrRecibo} (caracteres 6 a 11 do recibo).</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="7"/>
                    <xs:pattern value="20[0-9]{2}-(0[1-9]|1[0-2])"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="infoDebOpOfPublic" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de títulos de dívida com oferta pública.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="semTitulos" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Indicação da inexistência de títulos de dívida com oferta pública movimentados no período. Preenchimento: Deve ser preenchido exclusivamente quando o contribuinte não possuir movimento com títulos de dívida com oferta pública a detalhar no período de apuração {perApur}.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="1"/>
                    <xs:pattern value="1:Sem movimento com títulos de dívida com oferta pública neste período"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="infoTitulo" minOccurs="0" maxOccurs="100">
                <xs:annotation>
                  <xs:documentation>Informações do título de dívida com oferta pública.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="cCta" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Código da Conta Analítica (como informada no evento D-1011.{cCta}). Nota: Devem estar no PGCC vigente no último dia do {perApur} todas as contas que tiveram movimentação no período, ainda que tenham sido criadas ou encerradas no período. Validação: Não informar contas sintéticas. O {cCta} deve existir e estar vigente na tabela PGCC do contribuinte no último dia do {perApur} correspondente.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:maxLength value="53"/>
                        <xs:pattern value="[0-9A-Za-z]+"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="detTitulo" minOccurs="1" maxOccurs="500">
                    <xs:annotation>
                      <xs:documentation>Detalhamento do título.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:sequence>
                      <xs:element name="descFundo" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Descrição do nome do fundo. Validação: Obrigatório se {tpAquis} = [2].</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:maxLength value="255"/>
                            <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="tpAquis" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Tipo de aquisição dos títulos de dívida com oferta pública (art. 195).</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:enumeration value="1">
                              <xs:annotation><xs:documentation>Compra direta (§ 1º do Art. 195)</xs:documentation></xs:annotation>
                            </xs:enumeration>
                            <xs:enumeration value="2">
                              <xs:annotation><xs:documentation>Compra por meio de fundos de investimento exclusivos com composição mínima de 95% de títulos de dívida (§ 2º do Art. 195)</xs:documentation></xs:annotation>
                            </xs:enumeration>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="CNPJDevedor" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Informar o número de inscrição no CNPJ do devedor emitente do título de dívida. Validação: Deve ser um CNPJ válido com 14 posições.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="14"/>
                            <xs:pattern value="[0-9A-Z]{12}[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="dtAquisicao" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Data de aquisição do título de dívida. Máscara: AAAA-MM-DD Validação: Deve ser uma data válida.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="10"/>
                            <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="dtInicioJuros" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Data base referência de início do cálculo dos juros pagos em {dtFimJuros}. Máscara: AAAA-MM-DD Validação: Deve ser uma data válida igual ou posterior a {dtAquisicao}.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="10"/>
                            <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="dtFimJuros" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Data de reconhecimento da receita dos juros sobre os títulos de dívida. Máscara: AAAA-MM-DD Validação: A data deve estar dentro do {perApur} deste evento. Deve ser uma data válida igual ou posterior a {dtAquisicao}.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="10"/>
                            <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="dtLiquidacao" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Data de liquidação do título de dívida. Máscara: AAAA-MM-DD Validação: A data deve estar dentro do {perApur} deste evento. Deve ser uma data válida igual ou posterior a {dtAquisicao}.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="10"/>
                            <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vInicTitulo" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Representa o valor do título sobre o qual haverá a incidência dos juros no período. Preenchimento: Deve ser igual ao {vFinalTitulo} do período anterior para o mesmo {idTitulo} (exceto na primeira competência do declarante).</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vFinalTitulo" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor do título ao final do período (após o pagamento dos juros e amortizações)</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="pJuros" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Taxa de juros do período compreendido entre {dtInicioJuros} e {dtFimJuros}. Preenchimento: Não usar o símbolo (%).</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="8"/>
                            <xs:maxLength value="10"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{6}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vJuros" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor da receita de juros e demais rendimentos financeiros auferidos sobre o título no período. Cálculo: {vInicTitulo} * {pJuros} / 100</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="pSelic" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Taxa da Selic diária acumulada do período compreendido entre {dtInicioJuros} e {dtFimJuros}. Preenchimento: Não usar o símbolo (%).</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="8"/>
                            <xs:maxLength value="10"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{6}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vSelic" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor equivalente à variação da taxa Selic no período. Representa o teto tributável para a operação. Cálculo: {vInicTitulo} * {pSelic} / 100</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vPisCofins" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor da dedução relativa ao PIS/COFINS incidente sobre a receita tributada. Nota: Informar apenas a parcela passível de dedução da base de cálculo do IBS/CBS.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vApur" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor base sobre o qual serão aplicadas as regras definidas pelo código de tributação ({codTrib}). Cálculo: (MENORENTRE({vSelic} e {vJuros})) - {vPisCofins}</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      </xs:sequence>
                      <xs:attribute name="idTitulo" use="required">
                        <xs:annotation>
                          <xs:documentation>Código de identificação do título conforme padrão adotado (referencia ISO 6166 ou ISIN). Validação: Se {tpAquis} = [2], preencher com número sequencial único para o título dentro do {cCta}.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:maxLength value="30"/>
                            <xs:pattern value="[0-9A-Za-z]{1,30}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:attribute>
                    </xs:complexType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          </xs:sequence>
          <xs:attribute name="id" use="required">
            <xs:annotation>
              <xs:documentation>Identificador que representa unicamente o evento.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:whiteSpace value="preserve"/>
                <xs:length value="42"/>
                <xs:pattern value="DeRE[0-9]{4}[1-2][A-Z0-9]{14}[0-9]{19}"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
        <xs:element ref="ds:Signature"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>